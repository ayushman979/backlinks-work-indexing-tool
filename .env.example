# ── Database (Postgres) ──────────────────────────────────────────
# With docker compose: docker compose up -d
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bw_indexing?schema=public"

# ── Redis (BullMQ job queue) ─────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── API / Web ────────────────────────────────────────────────────
API_PORT=3001
API_BASE_URL="http://localhost:3001"
WEB_BASE_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"

# ── Auth / Session ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-string"
SESSION_SECRET="change-me-to-another-long-random-string"
JWT_EXPIRES_IN="7d"

# ── Credential encryption (SA JSON at rest) ──────────────────────
# Prefer a dedicated key; falls back to JWT_SECRET if unset.
# Generate with: openssl rand -base64 32
CREDENTIALS_ENCRYPTION_KEY="change-me-to-a-long-random-encryption-key"

# Optional directory for encrypted SA blobs (gitignored)
SA_STORAGE_DIR="../../data/service-accounts"

# ── Google Indexing API (service account) ────────────────────────
# Do NOT invent or commit real credentials.
# Upload JSON via the Connect SA UI (stored encrypted), or set path for local testing.
GOOGLE_APPLICATION_CREDENTIALS=""
GOOGLE_PROJECT_ID=""
# Scopes used by Indexing API client (owner-verified URLs only)
GOOGLE_INDEXING_SCOPE="https://www.googleapis.com/auth/indexing"
# Set to 1 to skip live HTTP and return stub success (local/CI)
GOOGLE_INDEXING_STUB="0"

# ── Credits defaults (agency MVP) ────────────────────────────────
CREDITS_DEFAULT_BALANCE=1000
CREDITS_COST_PER_URL=1
CREDITS_COST_PER_BACKLINK=1

# ── Worker ───────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_MS=2000
